# Backend — Variáveis de Ambiente
# ⚠️ SUBSTITUA o valor de DATABASE_URL pela connection string do seu projeto Neon
# Formato: postgresql://user:password@host/dbname?sslmode=require

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="odontosync-super-secret-key-change-me"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=3333

# SMTP Config (Opcional - caso vazias, utiliza fallback resiliente via Ethereal Mail)
SMTP_HOST=""
